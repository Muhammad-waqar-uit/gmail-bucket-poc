# gmail-bucket POC — local files

# memory = in-memory demo, no Google account needed
# drive  = Google Drive, buckets are folders inside a base folder
# gmail  = Gmail, buckets are labels under a root label
# auto   = Drive if usable, else Gmail, else memory
STORAGE=auto

PORT=4570
HOST=127.0.0.1

# ---------- base folder / label ----------

# Drive base folder: either a folder id you already have...
# DRIVE_ROOT_FOLDER_ID=

# ...or a folder name under "My Drive" (default: bucket-base).
# DRIVE_ROOT_FOLDER_NAME=bucket-base

# Set to 0 to refuse creating the base folder automatically (it must exist).
# DRIVE_CREATE_ROOT=1

# Gmail backend: buckets become labels "<root>/<bucket>"
GMAIL_BUCKET_ROOT_LABEL=gmail-bucket

# Where credentials.json / token.json live (default: ~/.gmail-bucket)
# GMAIL_BUCKET_DIR=

# Alternative to ~/.gmail-bucket/credentials.json (good for headless/hosted runs).
# For a permanent login you also need a refresh token: either run "npm run auth"
# once and copy token.json's refresh_token here, or omit these and use the file flow.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
